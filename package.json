    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "framer-motion": "latest",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "zod": "^4.5.4"
